{% assign repo_slug = include.repository | replace: '/', '--' %}
{% assign card_prefix = '/assets/img/repository-cards/' | append: repo_slug %}
{% assign card_modes = 'light,dark' | split: ',' %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}">
    {% for card_mode in card_modes %}
      {% assign card_path = card_prefix | append: '--300--' | append: card_mode | append: '.svg' %}
      <img class="only-{{ card_mode }}" src="{{ card_path | relative_url }}" alt="{{ include.repository }}" decoding="async">
    {% endfor %}
  </a>
</div>
